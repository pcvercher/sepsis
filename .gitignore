.claude/settings.local.json
# Agent worktrees (super-board / super-build / ui-refine-loop) and their .run dirs
.claude/worktrees/
# Legacy worktree location
.worktrees/
# Tool scratch output (visual skill, ad-hoc runs)
_tmp/
.visual/

# --- Data: keep patient/clinical data out of git ---
data/raw/
data/interim/
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.sqlite3
*.db

